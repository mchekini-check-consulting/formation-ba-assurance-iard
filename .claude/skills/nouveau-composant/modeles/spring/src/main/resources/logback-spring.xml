<?xml version="1.0" encoding="UTF-8"?>
<!-- Une ligne JSON par log sur stdout (convention de la plateforme, lue par Alloy). Niveaux : application.yaml -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="__PAQUET__.logging.JsonLogLayout" />
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
